{
  "schemaVersion": 3,
  "templateSource": "business-website",
  "templateVersion": "1.3.0",
  "framework": "react-router-7",
  "runtime": {
    "packageManager": "npm",
    "install": "npm install",
    "dev": {
      "command": "npm run dev -- --host 0.0.0.0",
      "port": 5173,
      "readyPath": "/"
    },
    "entryPoint": "app/root.tsx",
    "typecheck": "npm run typecheck",
    "build": "npm run build",
    "start": "npm run start",
    "healthPath": "/api/health"
  },
  "database": {
    "required": false,
    "extensions": []
  },
  "branding": {
    "config": "app/config/brand.generated.json",
    "assets": "public"
  },
  "env": {
    "required": []
  },
  "protectedPaths": [
    "app/components/ui",
    "app/lib/utils.ts",
    "app/lib/seo.ts",
    "app/routes.ts",
    "react-router.config.ts",
    "vite.config.ts",
    "tsconfig.json",
    "components.json",
    "app/components/sections/Section.tsx",
    "app/components/site/ThemeToggle.tsx"
  ],
  "sharedModules": [
    "app/lib/content.ts",
    "app/config/site.ts",
    "app/components/sections/Section.tsx"
  ],
  "globalConfig": [
    "app/app.css",
    "app/config/brand.generated.json"
  ],
  "editableSurfaces": [
    {
      "id": "site.brand",
      "kind": "CONFIG",
      "label": "Brand identity",
      "sourcePath": "app/config/brand.generated.json",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_ASSET"
      ],
      "fields": [
        {
          "path": "name",
          "label": "Business name",
          "type": "text"
        },
        {
          "path": "nameParts.lead",
          "label": "Name, first word",
          "type": "text"
        },
        {
          "path": "nameParts.accent",
          "label": "Name, second word",
          "type": "text"
        },
        {
          "path": "description",
          "label": "What the business does",
          "type": "rich_text"
        },
        {
          "path": "tagline",
          "label": "Tagline",
          "type": "text"
        },
        {
          "path": "url",
          "label": "Public site URL",
          "type": "text"
        },
        {
          "path": "logoPath",
          "label": "Logo",
          "type": "asset"
        }
      ]
    },
    {
      "id": "site.navigation",
      "kind": "CONFIG",
      "label": "Navigation and contact details",
      "sourcePath": "app/config/site.ts",
      "operations": [
        "UPDATE_CONTENT",
        "REORDER_SECTIONS",
        "CHANGE_VISIBILITY"
      ]
    },
    {
      "id": "design.tokens",
      "kind": "DESIGN",
      "label": "Colour, type and radius",
      "sourcePath": "app/app.css",
      "operations": [
        "UPDATE_DESIGN_TOKEN"
      ],
      "fields": [
        {
          "path": "--brand",
          "label": "Brand colour",
          "type": "color"
        },
        {
          "path": "--brand-foreground",
          "label": "Text on brand colour",
          "type": "color"
        },
        {
          "path": "--background",
          "label": "Page background",
          "type": "color"
        },
        {
          "path": "--foreground",
          "label": "Body text",
          "type": "color"
        },
        {
          "path": "--radius",
          "label": "Corner radius",
          "type": "text"
        }
      ]
    },
    {
      "id": "site.header",
      "kind": "COMPONENT",
      "label": "Site header",
      "sourcePath": "app/components/site/Header.tsx",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT",
        "CREATE_COMPONENT_VARIANT"
      ]
    },
    {
      "id": "site.footer",
      "kind": "COMPONENT",
      "label": "Site footer",
      "sourcePath": "app/components/site/Footer.tsx",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT",
        "CREATE_COMPONENT_VARIANT"
      ]
    },
    {
      "id": "section.hero",
      "kind": "SECTION",
      "label": "Hero",
      "page": "/",
      "sourcePath": "app/components/sections/Hero.tsx",
      "contentPath": "app/content/home.hero.json",
      "selector": "[data-section=\"section.hero\"]",
      "operations": [
        "UPDATE_CONTENT",
        "REGENERATE_CONTENT"
      ],
      "variants": [
        {
          "id": "centered",
          "label": "Centered",
          "description": "Big centred headline on a plain ground. Calm and corporate; needs no imagery."
        }
      ],
      "fields": [
        {
          "path": "eyebrow",
          "label": "Eyebrow",
          "type": "text",
          "maxLength": 40
        },
        {
          "path": "title",
          "label": "Headline",
          "type": "text",
          "maxLength": 90,
          "required": true
        },
        {
          "path": "description",
          "label": "Supporting paragraph",
          "type": "rich_text",
          "maxLength": 240
        },
        {
          "path": "primaryAction.label",
          "label": "Primary button",
          "type": "text",
          "maxLength": 24,
          "required": true
        },
        {
          "path": "primaryAction.to",
          "label": "Primary link",
          "type": "text",
          "generative": false
        },
        {
          "path": "secondaryAction.label",
          "label": "Secondary button",
          "type": "text",
          "maxLength": 24
        },
        {
          "path": "secondaryAction.to",
          "label": "Secondary link",
          "type": "text",
          "generative": false
        }
      ]
    },
    {
      "id": "section.approach",
      "kind": "SECTION",
      "label": "How we work",
      "page": "/",
      "sourcePath": "app/routes/home.tsx",
      "contentPath": "app/content/home.approach.json",
      "selector": "[data-section=\"section.approach\"]",
      "operations": [
        "UPDATE_CONTENT",
        "REGENERATE_CONTENT"
      ],
      "fields": [
        {
          "path": "eyebrow",
          "label": "Eyebrow",
          "type": "text",
          "maxLength": 40
        },
        {
          "path": "title",
          "label": "Heading",
          "type": "text",
          "maxLength": 90,
          "required": true
        },
        {
          "path": "description",
          "label": "Supporting paragraph",
          "type": "rich_text",
          "maxLength": 260
        },
        {
          "path": "items",
          "label": "Points",
          "type": "list",
          "min": 2,
          "max": 4,
          "itemFields": [
            {
              "path": "term",
              "label": "Title",
              "type": "text",
              "maxLength": 48,
              "required": true
            },
            {
              "path": "detail",
              "label": "Detail",
              "type": "rich_text",
              "maxLength": 220,
              "required": true
            }
          ],
          "required": true
        }
      ]
    },
    {
      "id": "section.services",
      "kind": "COMPONENT",
      "label": "Services grid",
      "sourcePath": "app/components/sections/ServiceGrid.tsx",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT",
        "CREATE_COMPONENT_VARIANT"
      ]
    },
    {
      "id": "section.pricing",
      "kind": "COMPONENT",
      "label": "Pricing table",
      "page": "/pricing",
      "sourcePath": "app/components/sections/PricingTable.tsx",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT",
        "CREATE_COMPONENT_VARIANT"
      ]
    },
    {
      "id": "section.posts",
      "kind": "COMPONENT",
      "label": "Post list",
      "sourcePath": "app/components/sections/PostList.tsx",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT",
        "CREATE_COMPONENT_VARIANT"
      ]
    },
    {
      "id": "section.faq",
      "kind": "SECTION",
      "label": "FAQ",
      "page": "/",
      "sourcePath": "app/routes/home.tsx",
      "contentPath": "app/content/home.faq.json",
      "selector": "[data-section=\"section.faq\"]",
      "operations": [
        "UPDATE_CONTENT",
        "REGENERATE_CONTENT"
      ],
      "fields": [
        {
          "path": "eyebrow",
          "label": "Eyebrow",
          "type": "text",
          "maxLength": 40
        },
        {
          "path": "title",
          "label": "Heading",
          "type": "text",
          "maxLength": 90,
          "required": true
        },
        {
          "path": "entries",
          "label": "Questions",
          "type": "list",
          "min": 2,
          "max": 8,
          "itemFields": [
            {
              "path": "question",
              "label": "Question",
              "type": "text",
              "maxLength": 120,
              "required": true
            },
            {
              "path": "answer",
              "label": "Answer",
              "type": "rich_text",
              "maxLength": 400,
              "required": true
            }
          ],
          "required": true
        }
      ]
    },
    {
      "id": "section.cta",
      "kind": "SECTION",
      "label": "Call to action",
      "page": "/",
      "sourcePath": "app/components/sections/CallToAction.tsx",
      "contentPath": "app/content/home.cta.json",
      "selector": "[data-section=\"section.cta\"]",
      "operations": [
        "UPDATE_CONTENT",
        "REGENERATE_CONTENT"
      ],
      "fields": [
        {
          "path": "title",
          "label": "Heading",
          "type": "text",
          "maxLength": 70,
          "required": true
        },
        {
          "path": "description",
          "label": "Supporting paragraph",
          "type": "rich_text",
          "maxLength": 200,
          "required": true
        },
        {
          "path": "action.label",
          "label": "Button",
          "type": "text",
          "maxLength": 28,
          "required": true
        },
        {
          "path": "action.to",
          "label": "Button link",
          "type": "text",
          "generative": false
        }
      ]
    },
    {
      "id": "section.principles",
      "kind": "CONTENT",
      "label": "Working principles",
      "page": "/about",
      "sourcePath": "app/routes/about.tsx",
      "selector": "principles",
      "operations": [
        "UPDATE_CONTENT",
        "REORDER_SECTIONS"
      ]
    },
    {
      "id": "section.team",
      "kind": "CONTENT",
      "label": "Team members",
      "page": "/about",
      "sourcePath": "app/routes/about.tsx",
      "selector": "team",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_ASSET",
        "REORDER_SECTIONS"
      ]
    },
    {
      "id": "section.contact-form",
      "kind": "COMPONENT",
      "label": "Enquiry form",
      "page": "/contact",
      "sourcePath": "app/routes/contact.tsx",
      "operations": [
        "UPDATE_CONTENT",
        "CONFIGURE_COMPONENT"
      ]
    },
    {
      "id": "content.services",
      "kind": "SECTION",
      "label": "Services",
      "sourcePath": "app/lib/content.ts",
      "contentPath": "app/content/services.json",
      "selector": "services",
      "operations": [
        "UPDATE_CONTENT",
        "REGENERATE_CONTENT",
        "REORDER_SECTIONS"
      ],
      "fields": [
        {
          "path": "services",
          "label": "Service",
          "type": "list",
          "required": true,
          "min": 2,
          "max": 6,
          "itemFields": [
            {
              "path": "slug",
              "label": "URL slug",
              "type": "text",
              "maxLength": 60,
              "required": true,
              "generative": false
            },
            {
              "path": "title",
              "label": "Service name",
              "type": "text",
              "maxLength": 40,
              "required": true
            },
            {
              "path": "summary",
              "label": "One-line summary",
              "type": "text",
              "maxLength": 120,
              "required": true
            },
            {
              "path": "description",
              "label": "Full description",
              "type": "rich_text",
              "maxLength": 400,
              "required": true
            },
            {
              "path": "startingAt",
              "label": "Starting price",
              "type": "text",
              "maxLength": 20,
              "required": true
            },
            {
              "path": "outcomes",
              "label": "Outcome",
              "type": "list",
              "required": true,
              "min": 2,
              "max": 5,
              "maxLength": 70
            }
          ]
        }
      ]
    },
    {
      "id": "content.posts",
      "kind": "CONTENT",
      "label": "Blog posts",
      "sourcePath": "app/lib/content.ts",
      "selector": "posts",
      "operations": [
        "UPDATE_CONTENT",
        "REORDER_SECTIONS"
      ],
      "fields": [
        {
          "path": "title",
          "label": "Post title",
          "type": "text"
        },
        {
          "path": "excerpt",
          "label": "Excerpt",
          "type": "rich_text"
        },
        {
          "path": "body",
          "label": "Body paragraphs",
          "type": "rich_text"
        },
        {
          "path": "author",
          "label": "Author",
          "type": "text"
        },
        {
          "path": "publishedAt",
          "label": "Published date",
          "type": "text"
        }
      ]
    },
    {
      "id": "content.plans",
      "kind": "SECTION",
      "label": "Pricing plans",
      "sourcePath": "app/lib/content.ts",
      "contentPath": "app/content/plans.json",
      "selector": "plans",
      "operations": [
        "UPDATE_CONTENT",
        "REGENERATE_CONTENT",
        "REORDER_SECTIONS"
      ],
      "fields": [
        {
          "path": "plans",
          "label": "Plan",
          "type": "list",
          "required": true,
          "min": 2,
          "max": 4,
          "itemFields": [
            {
              "path": "name",
              "label": "Plan name",
              "type": "text",
              "maxLength": 30,
              "required": true
            },
            {
              "path": "price",
              "label": "Price",
              "type": "text",
              "maxLength": 20,
              "required": true
            },
            {
              "path": "cadence",
              "label": "Billing cadence",
              "type": "text",
              "maxLength": 30,
              "required": true
            },
            {
              "path": "summary",
              "label": "Summary",
              "type": "text",
              "maxLength": 140,
              "required": true
            },
            {
              "path": "highlighted",
              "label": "Highlight this plan",
              "type": "boolean"
            },
            {
              "path": "features",
              "label": "Feature",
              "type": "list",
              "required": true,
              "min": 3,
              "max": 7,
              "maxLength": 70
            }
          ]
        }
      ]
    },
    {
      "id": "home.content",
      "kind": "COMPONENT",
      "label": "Homepage content",
      "page": "/",
      "sourcePath": "app/routes/home.tsx",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT"
      ]
    },
    {
      "id": "services.content",
      "kind": "COMPONENT",
      "label": "Services page",
      "page": "/services",
      "sourcePath": "app/routes/services.tsx",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT"
      ]
    },
    {
      "id": "service-detail.content",
      "kind": "COMPONENT",
      "label": "Service detail page",
      "page": "/services/:slug",
      "sourcePath": "app/routes/service-detail.tsx",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT"
      ]
    },
    {
      "id": "blog.content",
      "kind": "COMPONENT",
      "label": "Blog index",
      "page": "/blog",
      "sourcePath": "app/routes/blog.tsx",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT"
      ]
    },
    {
      "id": "blog-post.content",
      "kind": "COMPONENT",
      "label": "Blog post page",
      "page": "/blog/:slug",
      "sourcePath": "app/routes/blog-post.tsx",
      "operations": [
        "UPDATE_CONTENT",
        "UPDATE_DESIGN_TOKEN",
        "CONFIGURE_COMPONENT"
      ]
    }
  ],
  "featureSlots": [],
  "pageManifestDirectory": "page-manifests",
  "pages": [
    {
      "id": "home",
      "manifest": "page-manifests/home/page.manifest.json"
    },
    {
      "id": "about",
      "manifest": "page-manifests/about/page.manifest.json"
    },
    {
      "id": "services",
      "manifest": "page-manifests/services/page.manifest.json"
    },
    {
      "id": "service-detail",
      "manifest": "page-manifests/service-detail/page.manifest.json"
    },
    {
      "id": "pricing",
      "manifest": "page-manifests/pricing/page.manifest.json"
    },
    {
      "id": "blog",
      "manifest": "page-manifests/blog/page.manifest.json"
    },
    {
      "id": "blog-post",
      "manifest": "page-manifests/blog-post/page.manifest.json"
    },
    {
      "id": "contact",
      "manifest": "page-manifests/contact/page.manifest.json"
    },
    {
      "id": "site-chrome",
      "manifest": "page-manifests/site-chrome/page.manifest.json"
    },
    {
      "id": "shared-sections",
      "manifest": "page-manifests/shared-sections/page.manifest.json"
    },
    {
      "id": "site-content",
      "manifest": "page-manifests/site-content/page.manifest.json"
    }
  ],
  "verification": [
    "typecheck-passes",
    "build-succeeds",
    "health-endpoint-returns-ok",
    "sitemap-lists-every-page",
    "each-page-has-a-unique-title-and-canonical"
  ]
}
